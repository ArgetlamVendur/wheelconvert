<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dependency-free test runner (no xUnit) so Core tests run anywhere, including offline.
    Run: dotnet run (double-dash)project tests/WheelConvert.Core.Tests (see README). Exit code 0 = all passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Test code: relax rules meant for library APIs. -->
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1031;CA2007;CA1849;CA1305;CA1307;CA1310</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WheelConvert.Core\WheelConvert.Core.csproj" />
  </ItemGroup>
</Project>
