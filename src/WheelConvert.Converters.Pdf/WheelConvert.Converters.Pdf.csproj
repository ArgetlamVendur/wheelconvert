<Project Sdk="Microsoft.NET.Sdk">
  <!-- WP-08 PDF operations + page renderer. Spec: docs/modules/WP-08-pdf-operations.md -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WheelConvert.Converters.Pdf</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WheelConvert.Core\WheelConvert.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exact pin: PDFsharp 6.5.0+ is AGPL-3.0, banned by ADR-005. 6.2.4 is the last MIT release (ADR-010). -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\health-check.pdf" LogicalName="WheelConvert.Converters.Pdf.health-check.pdf" />
    <InternalsVisibleTo Include="WheelConvert.Converters.Pdf.Tests" />
  </ItemGroup>
</Project>
