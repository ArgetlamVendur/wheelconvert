<Project Sdk="Microsoft.NET.Sdk">
  <!-- WP-07 audio/video converter (external FFmpeg, ADR-004). Spec: docs/modules/WP-07-media-converter.md -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WheelConvert.Converters.Media</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WheelConvert.Core\WheelConvert.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests use the internal constructor (fake locator/runner) so CI covers failure and cancel paths without FFmpeg. -->
    <InternalsVisibleTo Include="WheelConvert.Converters.Media.Tests" />
  </ItemGroup>
  <!-- No packages: FFmpeg runs through Core's ProcessRunner. -->
</Project>
