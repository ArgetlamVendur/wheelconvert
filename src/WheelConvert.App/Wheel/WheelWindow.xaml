<Window x:Class="WheelConvert.App.Wheel.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WheelConvert"
        Width="260" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        AllowDrop="True">
    <!--
      ADR-003 / WP-04 req. 3: fully transparent pixels don't receive drops, so the disc (including the centre hole)
      is painted with alpha >= 1; only the corners outside the disc are transparent.
      The disc diameter is twice WheelWindow.OuterRadius.
    -->
    <Grid>
        <Ellipse Width="250" Height="250" Fill="#CC202020" Stroke="#66FFFFFF" StrokeThickness="1" />
        <Canvas x:Name="SegmentCanvas" />
        <TextBlock x:Name="CenterLabel"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="76" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="White" FontSize="14" Text="" />
    </Grid>
</Window>
