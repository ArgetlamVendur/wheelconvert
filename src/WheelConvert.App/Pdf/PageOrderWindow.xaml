<Window x:Class="WheelConvert.App.Pdf.PageOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="640" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Drag pages to reorder. Ctrl+Left/Right moves the selected page, Delete removes it. Removed pages are left out of the new file." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ReverseButton" Content="Reverse" Width="90" Margin="0,0,8,0" Click="OnReverse" />
            <Button x:Name="ResetButton" Content="Reset" Width="90" Margin="0,0,24,0" Click="OnReset" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="Save" Width="90" IsDefault="True" Click="OnSave" />
        </StackPanel>
        <ListBox x:Name="PageList" SelectionMode="Single" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="OnListMouseDown"
                 PreviewMouseMove="OnListMouseMove"
                 PreviewMouseLeftButtonUp="OnListMouseUp"
                 LostMouseCapture="OnListLostCapture">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="170" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Height="210" Background="#FFEEEEEE">
                            <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" />
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Grid>
                        <Button Content="✕" Width="24" Height="24" Padding="0" Margin="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="Remove this page" AutomationProperties.Name="Remove this page"
                                Click="OnRemoveClick" />
                        <TextBlock Grid.Row="1" Text="{Binding PageNumber, StringFormat=Page {0}}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
