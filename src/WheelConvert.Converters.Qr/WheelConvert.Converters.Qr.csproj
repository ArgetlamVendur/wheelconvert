<Project Sdk="Microsoft.NET.Sdk">
  <!-- WP-10 QR reader (images only, ADR-009). Spec: docs/modules/WP-10-qr-reader.md -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WheelConvert.Converters.Qr</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WheelConvert.Core\WheelConvert.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <!--
    WP-10 adds (latest stable, record in ADR-010):
      ZXing.Net            (decoding)
      Magick.NET-Q8-AnyCPU (load any image format into raw pixels for ZXing; same version as WP-06)
  -->
</Project>
